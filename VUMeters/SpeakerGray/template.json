    "#compositions*":[
        "associative array with keys",
        "The contents of each key must be objects which are associative arrays with keys",
        "'render_op' : one of 'single', 'aggregate', 'aggregate-off'",
        "   'static' => all placements are rendered regardless of volume_type anf volume level",
        "               rendering is fixed (static) as opposed to dynamic (changes with audio volume level)",
        "   'single' => only render the placement matching the volume level",
        "   'aggregate' => render all placements upto the volume level",
        "   'aggregate-off' => render all placements beyond the volume level",
        "'volume_type' : one of ",
        "       'sampled': volume levels are rendered to match sampled values",
        "       'peak-hold+sampled'  : peak volume level is held for a brief time and rendered in non-aggregated manner,",
        "                 lower volume levels are rendered to match sampled values",
        "       'decay' : (default) volume levels follows peak volume level decaying at configured rate, if lower",
        "       'peak-hold+decay' : peak volume level is held for a brief time and rendered in non-aggregated manner,",
        "                      lower volume levels follows peak volume level decaying at configured rate",
        "       Notes: ",
        "         1) decay is for use with VU Meters simulating analog VU Meters with needles",
        "         2) hold is for use with digital VU Meters, where multiple volume levels can be rendered in a frame",
        "         3) if peak is not set then volume levels are rendered to match sampled values",
        "'placements': an associative arrays of volume level to placements",
        "'render_op' and 'placements' are REQUIRED",
        " volume_type is optional:",
        "   - defaults to 'sampled'",
        "   - is ignored when the value 'render_op' is 'static'",
        "Notes:  Each non static object does not have to contain placement references for each volume level",
        "           However the combination of objects SHOULD contain placement references for each volume level"
    ],
    "compositions": {
        "L00": {
            "render_op": "static",
            "placements": [
                "LEFT_BG"
            ]
        },
        "R00": {
            "render_op": "static",
            "placements": [
                "RIGHT_BG"
            ]
        },
        "L01": {
            "render_op": "single",
            "volume_type": "decay",
            "placements": {
                "$SEQUENCE": [
                    { "start": 0,  "end": 48, "value": "L{index}"}
                ]
            }
        },
        "R01": {
            "render_op": "single",
            "volume_type": "decay",
            "placements": {
                "$SEQUENCE": [
                    { "start": 0,  "end": 48, "value": "R{index}"}
                ]
            }
        },
        "OFF-L": {
            "render_op": "static",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYANOFF-L-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGEOFF-L-{index}"},
                    { "start": 43,  "end": 48, "value": "LEDREDOFF-L-{index}"}
                ]
            }
        },
        "OFF-R": {
            "render_op": "static",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYANOFF-R-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGEOFF-R-{index}"},
                    { "start": 43,  "end": 48, "value": "LEDREDOFF-R-{index}"}
                ]
            }
        },
        "OFF-LL": {
            "render_op": "static",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYANOFF-LL-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGEOFF-LL-{index}"},
                    { "start": 43,  "end": 47, "value": "LEDREDOFF-LL-{index}"}
                ]
            }
        },
        "OFF-RR": {
            "render_op": "static",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYANOFF-RR-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGEOFF-RR-{index}"},
                    { "start": 43,  "end": 47, "value": "LEDREDOFF-RR-{index}"}
                ]
            }
        },
        "ON-L": {
            "render_op": "aggregate",
            "volume_type" : "peak-hold+sampled",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYAN-L-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGE-L-{index}"},
                    { "start": 43,  "end": 48, "value": "LEDRED-L-{index}"}
                ]
            }
        },
        "ON-R": {
            "render_op": "aggregate",
            "volume_type" : "peak-hold+sampled",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYAN-R-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGE-R-{index}"},
                    { "start": 43,  "end": 48, "value": "LEDRED-R-{index}"}
                ]
            }
        },
        "ON-LL": {
            "render_op": "aggregate",
            "volume_type" : "peak-hold+sampled",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYAN-LL-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGE-LL-{index}"},
                    { "start": 43,  "end": 47, "value": "LEDRED-LL-{index}"}
                ]
            }
        },
        "ON-RR": {
            "render_op": "aggregate",
            "volume_type" : "peak-hold+sampled",
            "placements": {
                "$SEQUENCE": [
                    { "start": 1,  "end": 36, "value": "LEDCYAN-RR-{index}"},
                    { "start": 37,  "end": 42, "value": "LEDORANGE-RR-{index}"},
