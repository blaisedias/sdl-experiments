            { "prefix": "amber_on", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "amber_on" },
            { "prefix": "amber_off", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "amber_off" },

            { "prefix": "red_on", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "red_on" },
            { "prefix": "red_off", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "red_off" },

            { "prefix": "pastel_green_on", "x":108, "y":0, "xstep": 36, "start":1, "end":36, "resource": "pastel_green_on" },
            { "prefix": "pastel_green_off", "x":108, "y":0, "xstep": 36, "start":1, "end":36, "resource": "pastel_green_off" },

            { "prefix": "pastel_red_on", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "pastel_red_on" },
            { "prefix": "pastel_red_off", "x":108, "y":0, "xstep": 36, "start":37, "end":49, "resource": "pastel_red_off" }
